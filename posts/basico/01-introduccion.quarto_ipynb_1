   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# Constantes físicas y astronómicas incluidas en Astropy\n",
    "# No necesitas buscarlas en Wikipedia ni copiar números a mano\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "\n",
    "# Importamos el módulo de constantes físicas\n",
    "from astropy import constants as const\n",
    "\n",
    "# El módulo de cosmología (que veremos más adelante) tiene constantes adicionales\n",
    "# como H0 (constante de Hubble). Por ahora usamos las del módulo constants:\n",
    "print(\"Constantes físicas incluidas en Astropy:\")\n",
    "print(f\"  Velocidad de la luz  : {const.c:.4e}\")   # c\n",
    "print(f\"  Masa del Sol         : {const.M_sun:.4e}\")  # M☉\n",
    "print(f\"  Radio de la Tierra   : {const.R_earth:.4e}\")  # R⊕\n",
    "print(f\"  Constante gravitacional: {const.G:.4e}\")  # G\n",
    "\n",
    "# Ejemplo: calculamos cuánto tarda la luz en llegar del Sol a la Tierra\n",
    "# Física básica: tiempo = distancia / velocidad\n",
    "distancia_sol = 1 * u.au             # distancia en unidades astronómicas\n",
    "velocidad_luz = const.c              # velocidad de la luz\n",
    "\n",
    "# El método .to() convierte el resultado a minutos\n",
    "tiempo_luz = (distancia_sol / velocidad_luz).to(u.minute)\n",
    "print(f\"\\nTiempo que tarda la luz Sol → Tierra: {tiempo_luz:.2f}\")"
   ]
