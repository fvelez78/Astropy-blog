    "### Coordenadas celestes: ubicar un objeto en el cielo"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "2a70a7a0",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Nebulosa de Orión (M42):\n",
      "  Ascensión recta  : 5h35m17.304s\n",
      "  Declinación      : -5d23m27.96s\n"
     ]
    }
   ],
   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# Ejemplo de coordenadas celestes\n",
    "# SkyCoord es la clase que representa una posición en el cielo\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "\n",
    "# Importamos SkyCoord para manejar posiciones en el cielo\n",
    "from astropy.coordinates import SkyCoord\n",
    "\n",
    "# Importamos units para acompañar los ángulos con su unidad\n",
    "import astropy.units as u\n",
    "\n",
    "# Creamos la posición de la famosa nebulosa de Orión (M42)\n",
    "# ra  = ascensión recta  (equivale a la \"longitud\" en el cielo)\n",
    "# dec = declinación      (equivale a la \"latitud\" en el cielo)\n",
    "# frame='icrs' es el sistema de referencia astronómico estándar\n",
    "nebulosa_orion = SkyCoord(\n",
    "    ra=83.8221 * u.degree,   # posición horizontal en el cielo\n",
    "    dec=-5.3911 * u.degree,  # posición vertical en el cielo\n",
    "    frame='icrs'             # sistema de coordenadas estándar\n",
    ")\n",
    "\n",
    "# Mostramos la posición en formato clásico de astronomía (horas:minutos:segundos)\n",
    "print(\"Nebulosa de Orión (M42):\")\n",
    "print(f\"  Ascensión recta  : {nebulosa_orion.ra.to_string(unit=u.hour)}\")\n",
    "print(f\"  Declinación      : {nebulosa_orion.dec.to_string()}\")"
   ]
  },
