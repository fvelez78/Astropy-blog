    "### Tiempo astronómico: más preciso que un reloj normal"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "d0117580",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Lanzamiento del telescopio James Webb:\n",
      "  Fecha normal    : 2021-12-25 12:20:00.000\n",
      "  Fecha Juliana   : 2459574.0139 días\n",
      "  Días en órbita  : 1612 d\n"
     ]
    }
   ],
   "source": [
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "# Ejemplo de tiempo astronómico\n",
    "# En astronomía necesitamos precisión de microsegundos y formatos especiales\n",
    "# ─────────────────────────────────────────────────────────────────────────────\n",
    "\n",
    "# Importamos la clase Time para manejar tiempos astronómicos\n",
    "from astropy.time import Time\n",
    "\n",
    "# Creamos un objeto de tiempo con la fecha del lanzamiento del telescopio\n",
    "# espacial James Webb (25 de diciembre de 2021)\n",
    "# format='iso' indica que el texto está en formato AAAA-MM-DD HH:MM:SS\n",
    "lanzamiento_webb = Time('2021-12-25 12:20:00', format='iso', scale='utc')\n",
    "\n",
    "# Convertimos a Fecha Juliana — el sistema de fechas que usan los astrónomos\n",
    "# cuenta los días desde el 1 de enero del año 4713 a.C.\n",
    "print(\"Lanzamiento del telescopio James Webb:\")\n",
    "print(f\"  Fecha normal    : {lanzamiento_webb.iso}\")\n",
    "print(f\"  Fecha Juliana   : {lanzamiento_webb.jd:.4f} días\")\n",
    "\n",
    "# Calculamos cuántos días han pasado desde el lanzamiento hasta hoy\n",
    "ahora = Time.now()                          # tiempo actual del sistema\n",
    "dias_transcurridos = (ahora - lanzamiento_webb).to(u.day)\n",
    "\n",
    "print(f\"  Días en órbita  : {dias_transcurridos:.0f}\")"
   ]
